# Copy this file to .env. Never share .env or include it in a ZIP.
DISCORD_TOKEN=your_bot_token
DISCORD_APPLICATION_ID=your_application_id
DISCORD_GUILD_ID=your_discord_server_id
# Required: only these channels accept requests (comma-separated IDs).
ALLOWED_CHANNEL_IDS=your_stage_or_text_channel_id
# Optional: restrict requests to members with one of these role IDs.
# Blank allows every member who can use commands in the allowed channels.
ALLOWED_ROLE_IDS=
# Enable chat requests in SpeshTV settings and use Copy connection token.
SPESHTV_BRIDGE_TOKEN=paste_connection_token_here
SPESHTV_BRIDGE_URL=http://127.0.0.1:47653
